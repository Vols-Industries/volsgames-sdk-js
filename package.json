{
  "name": "@volsgames/sdk",
  "version": "0.1.0",
  "description": "VolsGames client: WebTransport with WebSocket fallback, rooms, relay, reconnect",
  "license": "Apache-2.0",
  "repository": "github:Vols-Industries/volsgames-sdk-js",
  "homepage": "https://volsgames.com/docs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "e2e": "npm run build && node --test --test-concurrency=1 'e2e/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
